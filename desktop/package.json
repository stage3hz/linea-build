{
  "name": "invizent-desktop",
  "version": "0.14.13",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "description": "INVIZENT encrypted messenger for Windows",
  "author": "INVIZENT",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "test": "node --test test/*.test.mjs && node --test --test-isolation=none ../mobile/test/desktop-*.test.mjs",
    "build:ui": "node build-ui.mjs",
    "test:electron": "electron electron-smoke.cjs",
    "test:single-instance": "electron single-instance-smoke.cjs"
  },
  "dependencies": {
    "@signalapp/libsignal-client": "0.106.0",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.invizent.desktop",
    "productName": "INVIZENT",
    "asar": true,
    "asarUnpack": [
      "node_modules/@signalapp/libsignal-client/prebuilds/**",
      "node_modules/uiohook-napi/prebuilds/**"
    ],
    "files": [
      "main.cjs",
      "update.cjs",
      "notify.cjs",
      "preload.cjs",
      "overlay-preload.cjs",
      "overlay.html",
      "overlay.js",
      "capture-preload.cjs",
      "signal.mjs",
      "vault.mjs",
      "dist/**",
      "node_modules/**",
      "!node_modules/@signalapp/libsignal-client/prebuilds/{linux-*,darwin-*,win32-arm64}/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "INVIZENT-${version}-Windows-x64.exe",
      "icon": "../mobile/assets/icons/outline.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049",
      "shortcutName": "Инвиз",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "uninstallDisplayName": "Инвиз",
      "include": "build/installer.nsh"
    },
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  },
  "overrides": {
    "zod": "4.6.7",
    "uuid": "13.0.2"
  }
}
