# Exact DNS names without https://, paths or a trailing slash.
# You may use the apex names (example.ru/example.com) instead of api subdomains.
PUBLIC_HOST_RU=api.example.ru
PUBLIC_HOST_COM=api.example.com

# Native Android/iPhone requests do not need browser CORS origins.
# For an intentionally deployed web client, list exact HTTPS origins separated by commas.
ALLOWED_ORIGINS=
USER_STORAGE_MIB=512

# Необязательный серверный ключ AI. Без ключа AI явно недоступен.
# Не копировать в EXPO_PUBLIC_* и клиентские файлы.
OPENROUTER_API_KEY=
