{$PUBLIC_HOST_RU}, {$PUBLIC_HOST_COM} {
	# Public DNS and reachable ports 80/443 are required for automatic HTTPS.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# The API answers JSON and encrypted files only: no page may run scripts from here or frame it.
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
		X-Frame-Options "DENY"
		-Server
	}
	# Smaller JSON on slow mobile links (EDGE/3G). Not for sign-in answers (they carry the
	# session token next to what the user typed) and not for files (already encrypted, incompressible).
	@compressible not path /auth/* /files/* /e2ee/files* /uploads*
	encode @compressible zstd gzip

	handle / {
		header Content-Type "text/plain; charset=utf-8"
		respond "Инвиз — сервер мессенджера. Подключение из мобильного приложения." 200
	}
	handle {
		# WebSocket upgrades are handled by Caddy's reverse_proxy automatically.
		reverse_proxy api:3001
	}
}
