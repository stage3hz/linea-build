# Для телефона: сервер и телефон должны видеть друг друга по сети.
HOST=0.0.0.0
PORT=3001
DATA_DIR=./data
LOG_LEVEL=info

# Точные origins веб-клиента через запятую; native-приложение не требует CORS.
# Без значения HTTP-запросы с Origin будут отклонены.
ALLOWED_ORIGINS=http://localhost:8081

# Доверяйте только реальному reverse proxy. Не используйте wildcard.
# Пример: TRUSTED_PROXIES=127.0.0.1,::1
TRUSTED_PROXIES=

SESSION_TTL_DAYS=30
AUTH_RATE_LIMIT=20
USER_STORAGE_MIB=512

# Необязательный серверный ключ AI. Не добавляйте его в mobile/EXPO_PUBLIC_*.
# Используется только openrouter/free, платный маршрут не включается.
# Пустое значение показывает честное состояние «AI не подключён».
OPENROUTER_API_KEY=
