# Адрес API, доступный с телефона. localhost на телефоне — сам телефон.
# Для общей Wi-Fi сети: http://192.168.1.10:3001
# Для серверной установки: https://api.your-domain.example
EXPO_PUBLIC_API_URL=

# Только локальная разработка с dev runtime (__DEV__). Release/APK всё равно требует HTTPS.
# Не включать для распространяемой сборки. После изменения нужен новый prebuild.
EXPO_PUBLIC_ALLOW_LOCAL_HTTP=0
