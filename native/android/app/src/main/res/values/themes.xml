<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#08090A</color>
    <color name="text">#E5E5E6</color>

    <!-- The black theme. The window is black before the first page is drawn; the pages lie under the system's
         bars (MainActivity.edgeToEdge), whose icons are light. -->
    <style name="Theme.Invizent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/text</item>
        <item name="android:textColorHighlight">#4D8A8F98</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Fonts: every text is Montserrat, as in the reference (design/Fonts.kt); a bold text style takes its 700. -->
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textViewStyle">@style/Invizent.Text</item>
        <item name="android:editTextStyle">@style/Invizent.Field</item>
    </style>
    <!-- Fonts: the text and the fields of the app in Montserrat, even where a widget's own style names another face. -->
    <style name="Invizent.Text" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/montserrat</item>
    </style>
    <style name="Invizent.Field" parent="android:Widget.Material.EditText">
        <item name="android:fontFamily">@font/montserrat</item>
    </style>
</resources>
