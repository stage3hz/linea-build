<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Music: playing on while the app is not on the screen (music/MusicService.kt). The first two are given
         with the install; showing the player's notification is asked of the person on Android 13 and later, at
         the moment they first start the music — refused, the music plays all the same. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice and video messages (voice/, video/). The microphone is asked of the person when they first hold
         the record button, the camera when they first open the round video recorder — never at the start. The
         microphone records only while a take runs, the camera works only while that recorder is on screen.
         Neither is required: the app installs on a device without them. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Calls (calls/): the microphone and the camera above are asked of the person when a call first needs
         them. The four below are given with the install and ask nothing: choosing where a call sounds (the
         earpiece, the loudspeaker, headphones), the system's word on whether there is a network (nothing is
         contacted), the screen going dark at the ear, and the hum of an incoming call. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Shell: the update the account's server offers (shell/UpdateGate.kt), as the reference's withSelfUpdate: after
         «Установить» the build's APK is downloaded from this project's releases, its size and SHA-256 are checked, and
         the system installer is opened. The person still confirms the installation in the system's window (and allows
         «install from INVIZENT» once); nothing is installed silently. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- ScreenShare: showing this phone's screen in a voice channel (screenshare/ScreenShare.kt), as the reference declares
         it (plugins/withScreenBroadcast.js). The system asks the person for every share; a foreground service of the type
         «mediaProjection» holds the capture only while it runs. Security: the fingerprint or the face for «Код-пароль»
         (security/LockModel.kt, the reference's expo-local-authentication); given with the install, asks nothing. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Media: the paperclip's own panel (attachments/AttachmentPanel.kt) shows the gallery, as the reference's
         expo-media-library declares it: the person is asked only when the panel first opens, never at the start, and on
         Android 14 and later may allow only some photos and videos (READ_MEDIA_VISUAL_USER_SELECTED). Only photos and
         videos are read, never other files; the system's own pickers stay as the way without this access. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Push (push/): an incoming call while the app is closed — the ringing notification may open the app over the lock
         screen (push/IncomingCall.kt, the reference's modules/linea-call). On Android 14+ the person can switch this off
         in the app's notification settings. POST_NOTIFICATIONS above is asked once the account is open (push/Push.kt). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Push/Calls: the ongoing-call foreground service (push/OngoingCall.kt, the reference's linea-call CallService): type
         microphone — Android 11+ silences the microphone of an app in the background unless such a service runs. Given
         with the install; the service starts only once the microphone permission was given for a call. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/app_icon_outline"
        android:supportsRtl="true"
        android:theme="@style/Theme.Invizent"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="false">
        <!-- One window. It lays itself out again when the screen turns or changes size, and makes room for the
             keyboard itself (the chat's field rides on it). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:supportsPictureInPicture="true"
            android:exported="true">
            <!-- Links: an invitation to a channel or a server — linea://invite/CODE. The schemes are the previous app's:
                 Expo's prebuild registers `scheme: 'linea'` and the package name (app.config.js). Only the code is read
                 (links/DeepLinks.kt); the invitation itself is always asked from the account's own server. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="linea" android:host="invite" />
                <data android:scheme="${applicationId}" android:host="invite" />
            </intent-filter>
        </activity>
        <!-- Effects: the app's icon on the launcher, «Оформление › Иконка приложения» (settings/AppearanceEffects.kt), as
             the reference's expo-alternate-app-icons: one alias of the window per icon, exactly one enabled. «Контур» is
             the default. -->
        <activity-alias
            android:name=".MainActivityOutline"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/app_icon_outline"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityBlue"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/app_icon_default"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityLight"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/app_icon_light"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityAurora"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/app_icon_aurora"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Attachments: gives the one app the person chose the one decrypted file it was asked to show, to read
             only (attachments/DecryptedFileProvider.kt). Not exported: nothing can ask it on its own. -->
        <provider
            android:name=".attachments.DecryptedFileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Media: where the system's camera writes a photo taken from the paperclip's panel (attachments/CaptureProvider.kt).
             Not exported: only the camera app handed one address with a write grant can write that one file. -->
        <provider
            android:name=".attachments.CaptureProvider"
            android:authorities="${applicationId}.capture"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Media: ML Kit (the photo editor's «Фон», attachments/PhotoBackground.kt) is not started with the app: its own
             start-up provider is taken out, and it is started only when the person opens «Фон». -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:node="remove" />
        <!-- Music: keeps the playback, its notification and its lock-screen controls while the app is not on the
             screen. Not exported: only the app itself starts it. -->
        <!-- Profile: shows a friend's birthday reminder when the system's alarm clock rings for it (profile/Birthdays.kt).
             Not exported: only the app's own alarms reach it. The alarms are inexact: no extra permission. -->
        <receiver
            android:name=".profile.BirthdayReceiver"
            android:exported="false" />
        <!-- ScreenShare: holds the screen capture while this phone shares its screen. Not exported. -->
        <service
            android:name=".screenshare.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <!-- Push: what Firebase Cloud Messaging delivers (push/PushService.kt) — the token, a chat notification while the
             app's process is in front, the data message of a call to a closed app. Not exported: Firebase's own receiver
             hands it the messages. The defaults are the previous app's (expo-notifications: the icon, the colour, the
             channel `messages`). -->
        <service
            android:name=".push.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/notification_icon" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/notification_icon_color" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="messages" />
        <!-- Push/Calls: the call keeps going with the app in the background, «Имя · Звонок · 0:42» with «Завершить звонок»
             (push/OngoingCall.kt). Not exported: only the app starts it. -->
        <service
            android:name=".push.OngoingCallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- Push: «Отклонить» on the ringing notification of an incoming call (push/IncomingCall.kt). Not exported. -->
        <receiver
            android:name=".push.IncomingCallReceiver"
            android:exported="false" />
        <service
            android:name=".music.MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
